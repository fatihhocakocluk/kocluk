<!doctype html><html lang="tr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Öğretmen Paneli</title><link rel="stylesheet" href="/style.css"></head><body><header class="topbar"><a class="brand" href="/">FH <span>Öğrenci Takip</span></a><form method="post" action="/logout"><button class="button ghost">Çıkış</button></form></header><main class="container"><div class="pagehead"><div><div class="eyebrow">ÖĞRETMEN PANELİ</div><h1>Öğrenci dosyaları</h1><p>Her öğrenci için ayrı dosya açın; kayıtlarınız kalıcı olarak saklanır.</p></div><a class="button primary" href="/teacher/students/new">＋ Yeni öğrenci</a></div><% if(!students.length){ %><div class="empty card"><h2>Henüz öğrenci yok</h2><p>İlk öğrenci dosyanızı oluşturmak için “Yeni öğrenci”ye tıklayın.</p></div><% } else { %><div class="student-grid"><% students.forEach(s=>{ %><a class="student-card card" href="/teacher/students/<%= s.id %>"><div class="avatar"><%= s.name.trim().charAt(0).toUpperCase() %></div><div class="student-info"><h3><%= s.name %></h3><p><%= s.grade %></p><span><%= s.entry_count %> kayıt</span></div><span class="arrow">↗</span></a><% }) %></div><% } %></main></body></html>