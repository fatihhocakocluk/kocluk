<!doctype html><html lang="tr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Veli Raporu</title><link rel="stylesheet" href="/style.css"></head><body><header class="topbar"><a class="brand" href="/">FH <span>Veli Paneli</span></a><div class="top-actions"><a class="button ghost" href="/parent/child">Öğrenci değiştir</a><form method="post" action="/logout"><button class="button ghost">Çıkış</button></form></div></header><main class="container narrow"><div class="eyebrow">ÖĞRENCİ GELİŞİM RAPORU</div><h1><%= student.name %></h1><p class="muted"><%= student.grade %> · Güncel takip kayıtları</p><section class="card report-card"><h2>Öğretmen değerlendirmesi</h2><p class="comment"><%= report.comment || 'Öğretmen henüz değerlendirme eklememiş.' %></p></section><h2 class="mt">Ders, deneme ve kitap kayıtları</h2><% if(!entries.length){ %><div class="empty card">Henüz paylaşılmış takip kaydı yok.</div><% } else { %><div class="entry-list"><% entries.forEach(e=>{ %><article class="entry card"><div class="entry-top"><span class="pill"><%= e.kind %><%= e.section ? ' · '+e.section : '' %></span><span class="date"><%= e.entry_date %></span></div><h3><%= e.title %></h3><% if(e.subject){ %><p class="subject"><%= e.subject %></p><% } %><% if(e.score){ %><p><strong>Sonuç:</strong> <%= e.score %></p><% } %><% if(e.detail){ %><p><%= e.detail %></p><% } %></article><% }) %></div><% } %></main></body></html>